setColWidths(wb, "Contents", cols = 1:2, widths = "auto")
## Data Sheets
for (i in seq_along(tables)) {
sheet_name <- names(tables)[i]
data <- tables[[i]]
title <- titles[i]
addWorksheet(wb, sheet_name)
writeData(wb, sheet = sheet_name, x = title, startRow = 1, startCol = 1)
writeData(wb, sheet = sheet_name, x = data, startRow = 3, startCol = 1)
# Add Supplementary Legend for ST4 Marker genes
if(sheet_name == "ST4") {
legend_text <- "(1) PMID:37468583, (2) PMID:30826016, (3) PMID:34843404, (4) PMID:37280226"
legend_row <- nrow(st.4) + 4
# write legend
writeData(wb, sheet = sheet_name, x = legend_text, startRow = legend_row, startCol = 1)
# create style
legend_style <- createStyle(textDecoration = "italic", wrapText = F, halign = "left")
addStyle(wb, sheet = sheet_name, style = legend_style, rows = legend_row, cols = 1, gridExpand = T)
# Wrap gene list columns
wrap_style <- createStyle(wrapText = T, valign = "top")
gene_cols <- which(names(data) %in% marker_cols)
addStyle(wb, sheet = sheet_name, style = wrap_style,
rows = 4:(nrow(data) + 3), cols = gene_cols, gridExpand = T)
setColWidths(wb, sheet = sheet_name, cols = gene_cols, widths = 40)
}
# Add Color Styling for ST9
if (sheet_name == "ST9") {
for (row in 1:nrow(col.st9)) {
for (col in 1:ncol(col.st9)) {
score <- col.st9[row, col]
style_to_apply <- switch(as.character(score),
"2" = green_style,
"1" = orange_style,
"0" = red_style)  # no style or red_style
if (!is.null(style_to_apply)) {
addStyle(wb, sheet_name, style = style_to_apply, rows = row + 3, cols = col + 0, gridExpand = FALSE)
}
}
}
}
# Add Color Styling for ST12
if (sheet_name == "ST12") {
for (row in 1:nrow(col.st12)) {
for (col in 1:ncol(col.st12)) {
score <- col.st12[row, col]
style_to_apply <- switch(as.character(score),
"2" = green_style,
"1" = orange_style,
"0" = red_style)  # no style or red_style
if (!is.null(style_to_apply)) {
addStyle(wb, sheet_name, style = style_to_apply, rows = row + 3, cols = col + 0, gridExpand = FALSE)
}
}
}
}
# Styling
addStyle(wb, sheet = sheet_name, style = style_title, rows = 1, cols = 1, gridExpand = T)
addStyle(wb, sheet = sheet_name, style = style_header, rows = 3, cols = 1:ncol(data), gridExpand = T)
# Format numeric columns
numeric_cols <- which(sapply(data, is.numeric))
style_num <- createStyle(numFmt = "0.00")      # 2 decimals
addStyle(wb, sheet = sheet_name, style = style_num,
rows = 4:(nrow(data) + 3), cols = numeric_cols, gridExpand = TRUE)
# Column Width
width_vec <- apply(data[,], 2, function(x) max(nchar(as.character(x)) + 2, na.rm = TRUE)) # per column: widest cell value + 2
width_vec_header <- nchar(colnames(data))  + 2  # calculates header width + 2
max_vec_header <- pmax(width_vec, width_vec_header) # compares the 2 vector, takes wider one
max_vec_header <- pmin(max_vec_header,50) # min. col width is vector but only up to 50 characters
setColWidths(wb, sheet = sheet_name, cols = 1:ncol(data), widths = max_vec_header)
}
## Save
saveWorkbook(wb, file = paste0("../Supplementary_Tables_MS_", Sys.Date(), ".xlsx"), overwrite = T)
## Save
saveWorkbook(wb, file = paste0("../Supplementary_Tables_MS_", Sys.Date(), ".xlsx"), overwrite = T)
