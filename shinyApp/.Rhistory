#-------------------------------------------------#
## 4. Get detection Rates, P, OR, CI from direct atc-metabolite pairs
#-------------------------------------------------#
## Function: detection rates, Fishers exact test, OR, CI, P
run_positive_controls <- function(data_sub, med_sub, known_pairs) {
results <- list()
for (i in seq_len(nrow(known_pairs))) {
atc <- known_pairs$atc_code[i]
met <- known_pairs$CHEM_ID[i]
x_all <- med_sub[[atc]]
y_all <- data_sub[[met]]
# 2x2 counts
n_users_with    <- sum(x_all == 1 & y_all == 1, na.rm = TRUE)
n_users_without <- sum(x_all == 1 & y_all == 0, na.rm = TRUE)
n_non_with      <- sum(x_all == 0 & y_all == 1, na.rm = TRUE)
n_non_without   <- sum(x_all == 0 & y_all == 0, na.rm = TRUE)
n_users_total    <- n_users_with + n_users_without
n_nonusers_total <- n_non_with   + n_non_without
# Detection rates
rate_users    <- n_users_with / n_users_total
rate_nonusers <- n_non_with   / n_nonusers_total
# Fisher's exact test
tbl <- matrix(c(n_users_with, n_users_without,
n_non_with,   n_non_without),
nrow = 2,
dimnames = list(c("user", "non_user"),
c("metab_present", "metab_absent")))
ft <- fisher.test(tbl)
results[[i]] <- data.frame(
atc_code          = atc,
CHEM_ID           = met,
n_users_with      = n_users_with,
n_users_without   = n_users_without,
n_nonusers_with   = n_non_with,
n_nonusers_without = n_non_without,
rate_users        = round(rate_users, 4),
rate_nonusers     = round(rate_nonusers, 4),
OR                = ft$estimate,
CI_low            = ft$conf.int[1],
CI_high           = ft$conf.int[2],
P_value           = ft$p.value
)
}
res <- rbindlist(results, use.names = TRUE, fill = TRUE)
# Bonferroni correction across number of pairs tested
res$bonferroni_threshold  <- 0.05 / nrow(res)
res$bonferroni_significant <- res$P_value < res$bonferroni_threshold
res$neg_log10P            <- -log10(res$P_value)
return(res)
}
## added manually to Mona/Logistic_Regression/drug_metabolite_pairs.xlsx
manual <- read_xlsx("Mona/Logistic_Regression/drug_metabolite_pairs.xlsx") %>%
select(atc_code, CHEM_ID)
