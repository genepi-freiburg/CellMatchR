### Marker Genes: sort alphabetically, replace "," with ", "
process_marker_genes <- function(gene_str) {
if (is.na(gene_str) || gene_str == "") return (NA)
genes <- strsplit(gene_str, ",")[[1]] %>%
trimws() %>%
unique() %>%
sort()
paste(genes, collapse = ", ")
}
